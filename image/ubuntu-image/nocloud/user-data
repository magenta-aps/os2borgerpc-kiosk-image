#cloud-config
autoinstall:
  apt:
    primary:
    - arches: [amd64, i386]
      uri: http://dk.archive.ubuntu.com/ubuntu
    - arches: [default]
      uri: http://ports.ubuntu.com/ubuntu-ports
  identity: {
    hostname: os2borgerpc,
    password: $6$0y9sb.ZdlHsXbfSr$o6DKzeX02cKvmnQ/7qC5RRINRuBZNjCc/fBxwTwYuv9FipTiFkP.gxJdXWQIkhEL.oOI8YD2kdtlQQZVtHSd51,
    realname: Superuser,
    username: superuser
  }
  keyboard: {layout: dk, toggle: null, variant: ''}
  locale: en_US
  ssh:
    allow-pw: true
    authorized-keys: []
    install-server: false
  storage:
    layout:
        name: lvm

  late-commands:
    - cp -r /cdrom/scripts/* /target/usr/local/bin
    # Makes the auto login folder and copy the override.conf file to it
    - mkdir -p /target/etc/systemd/system/getty@tty1.service.d/
    - cp /cdrom/files/override.conf /target/etc/systemd/system/getty@tty1.service.d/override.conf
    # Makes the installation_wizard.sh run on login
    - cp /cdrom/files/installation_wizard.sh /target/etc/profile.d/installation_wizard.sh
    # This allows the wifi_setup and os2borgerpc_kiosk_setup to run without sudo password, made in writefiles
    - cp /cdrom/files/first_boot_setup /target/etc/sudoers.d/first_boot_setup
    # Add admin-url file
    - mkdir -p /target/etc/os2borgerpc
    - cp /cdrom/files/admin-url /target/etc/os2borgerpc/admin-url
    # Configure pipx bin directory
    - echo 'PIPX_BIN_DIR="/usr/local/bin"' >> /target/etc/environment

  version: 1
  interactive-sections:
    - storage
